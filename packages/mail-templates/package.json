{
    "name": "@repo/mail-templates",
    "module": "dist/index.js",
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "private": true,
    "scripts": {
        "build:dev": "bun build src/index.ts --outdir dist --target bun --packages external --format esm&& tsc",
        "build:prod": "bun build src/index.ts --outdir dist --target bun --packages external --format esm",
        "lint": "eslint --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "preview": "bun run src/utils/test-template.ts"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/bun": "latest",
        "@types/mjml": "^4.7.4"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "mjml": "^4.15.3"
    }
}
