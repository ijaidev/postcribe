{
    "name": "@repo/ai",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "private": true,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build:dev": "bun build src/index.ts --outdir dist --target bun --packages external && NODE_OPTIONS=\"--max_old_space_size=8192\" tsc",
        "build:prod": "bun build src/index.ts --outdir dist --target bun",
        "lint": "eslint . --max-warnings 0",
        "check-types": "tsc --noEmit"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@types/bun": "latest",
        "eslint": "^9.22.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@langchain/langgraph": "^0.3.6",
        "@langchain/langgraph-checkpoint-postgres": "^0.0.5",
        "@langchain/openai": "^0.5.18",
        "@langchain/tavily": "^0.1.4",
        "@repo/logger": "workspace:*",
        "@repo/redis": "workspace:*",
        "@repo/s3": "workspace:*",
        "langchain": "^0.3.29",
        "zod": "^3.24.4"
    }
}
