        "pino-roll": "^2.2.0"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/typescript-config": "*",
        "@types/bun": "latest",
        "eslint": "^9.22.0",
        "pino-pretty": "^13.0.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
