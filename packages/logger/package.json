{
    "name": "@repo/logger",
    "module": "dist/index.js",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "private": true,
    "scripts": {
        "build:dev": "bun build:prod && tsc",
        "build:prod": "bun build src/index.ts --outdir dist --target bun --packages external --format esm",
