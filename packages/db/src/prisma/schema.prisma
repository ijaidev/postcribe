datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Better Auth
model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  postCron      PostCron[]
  draft         Draft[]

  timeZone String

  socialLogins SocialLogin[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Posts Draft
model Draft {
  id              String         @id @default(uuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  isDeleted       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  Post            Post[]
  draftSchedule   DraftSchedule?
  @@map("draft")
}

// Post
model Post {
  id          String    @id @default(uuid())
  post        String
  imageUrl    String?
  mediaIds    String[]
  postType    PostType
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  draft       Draft     @relation(fields: [draftId], references: [id])
  draftId     String
  isDeleted Boolean @default(false)

  @@map("post")
}

enum PostType {
  X
  LINKEDIN
}

// Draft Schedule
model DraftSchedule {
  id          String    @id @default(uuid())
  draft       Draft     @relation(fields: [draftId], references: [id])
  draftId     String    @unique
  scheduledAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  isDeleted Boolean @default(false)

  @@map("draft_schedule")
}

// Post Cron
model PostCron {
  id             String       @id @default(uuid())
  title          String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  scheduledAt    DateTime
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  PostCronData   PostCronData @relation(fields: [postCronDataId], references: [id])
  postCronDataId String       @unique
  isDeleted      Boolean      @default(false)
  @@map("post_cron")
}

// Post Cron Data
model PostCronData {
  id            String    @id @default(uuid())
  message       String
  platform      Platform
  inputImages   String[]
  generateImage Boolean   @default(false)
  imagePrompt   String?
  forceWeb      Boolean
  postCron      PostCron?

  @@map("post_cron_data")
}

enum Platform {
  X
  LINKEDIN
  ALL
}

// Login
model SocialLogin {
  id String @id @default(uuid())
  name String
  provider LoginProvider
  userId String
  user User @relation(fields: [userId], references: [id])
  accessToken String
  refreshToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  state String?
  isConnected Boolean @default(false)
  isDeleted Boolean @default(false)

  @@map("social_login")
}

enum LoginProvider {
  X
  LINKEDIN
}