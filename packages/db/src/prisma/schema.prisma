datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Better Auth
model User {
  id            String     @id
  name          String?
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  postCron      PostCron[]
  draft         Draft[]

  timeZone String?

  socialLogins SocialLogin[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Posts Draft
model Draft {
  id            String         @id @default(uuid())
  title         String
  user          User           @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  posts         Post[]
  draftSchedule DraftSchedule?
  postCron      PostCron?      @relation(fields: [postCronId], references: [id], onDelete: Cascade)
  postCronId    String?        @unique
  isPublished   Boolean        @default(false)
  publishedAt   DateTime?
  isDeleted     Boolean        @default(false)
  cronState     CronState?

  @@map("draft")
}

enum CronState {
  DRAFT_CREATION
  AI_GENERATION
  MEDIA_UPLOAD
  POST_CREATION
  PLATFORM_PUBLISHING
  EMAIL_NOTIFICATION
  COMPLETED
}

// Post
model Post {
  id            String       @id @default(uuid())
  post          String
  imageUrl      String?
  socialLogin   SocialLogin @relation(fields: [socialLoginId], references: [id])
  socialLoginId String
  mediaIds      String[]
  postType      PostType
  isPublished   Boolean      @default(false)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  draft         Draft        @relation(fields: [draftId], references: [id])
  draftId       String
  isDeleted     Boolean      @default(false)

  @@map("post")
}

enum PostType {
  X
  LINKEDIN
}

// Draft Schedule
model DraftSchedule {
  id          String    @id @default(uuid())
  draft       Draft     @relation(fields: [draftId], references: [id])
  draftId     String    @unique
  scheduledAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  isDeleted   Boolean   @default(false)

  @@map("draft_schedule")
}

// Post Cron
model PostCron {
  id                 String             @id @default(uuid())
  title              String
  user               User               @relation(fields: [userId], references: [id])
  userId             String
  scheduledAt        DateTime
  repeatInterval     Int
  repeatIntervalUnit RepeatIntervalUnit
  nextRunAt          DateTime
  isActive           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  PostCronData       PostCronData       @relation(fields: [postCronDataId], references: [id])
  postCronDataId     String             @unique
  autoApprove        Boolean            @default(false)
  isDeleted          Boolean            @default(false)
  drafts             Draft[]

  @@map("post_cron")
}

enum RepeatIntervalUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
}

// Post Cron Data
model PostCronData {
  id                    String    @id @default(uuid())
  message               String
  platform              Platform
  inputImages           String[]
  xSocialLoginId        String?
  linkedinSocialLoginId String?
  generateImage         Boolean   @default(false)
  imagePrompt           String?
  forceWeb              Boolean
  postCron              PostCron?

  @@map("post_cron_data")
}

enum Platform {
  X
  LINKEDIN
  ALL
}

// Login
model SocialLogin {
  id           String        @id @default(uuid())
  name         String
  provider     LoginProvider
  userId       String
  userName     String?
  user         User          @relation(fields: [userId], references: [id])
  accessToken  String?
  refreshToken String?
  isVerified   Boolean?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  state        String?
  isConnected  Boolean       @default(false)
  isDeleted    Boolean       @default(false)
  posts        Post[]

  @@map("social_login")
}

enum LoginProvider {
  X
  LINKEDIN
}

// Email Rate Limiting
model EmailLog {
  id     String         @id @default(uuid())
  email  String
  type   EmailLogType
  sentAt DateTime       @default(now())

  @@map("email_log")
}

enum EmailLogType {
  verification
  reset
}
