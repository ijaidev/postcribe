{
  "name": "@repo/linkedin",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:dev": "bun build src/**/*.ts --outdir dist --target bun --packages external --root src && tsc",
    "build:prod": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "linkedin-api-client": "^0.3.0",
    "@repo/db": "workspace:*"
  }
}
