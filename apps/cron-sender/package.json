{
    "name": "@repo/cron-sender",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./dist/index.js",
        "./types": "./dist/types.d.ts"
    },
    "scripts": {
        "build:prod": "bun build src/index.ts --outdir dist --target node --packages external --format esm",
        "build:dev": "bun build:prod && NODE_OPTIONS=\"--max_old_space_size=8192\" tsc",
        "lint": "eslint --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "start": "bun build:prod && func start -p 7070"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@azure/functions": "4.7.2",
        "@repo/db": "workspace:*",
        "@repo/logger": "workspace:*"
    }
}
