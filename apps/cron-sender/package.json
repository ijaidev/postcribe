{
    "name": "@repo/cron-sender",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./dist/index.js",
        "./types": "./dist/types.d.ts"
    },
    "scripts": {
        "build:dev": "bun build src/index.ts --outdir dist --target bun --packages external && NODE_OPTIONS=\"--max_old_space_size=8192\" tsc",
        "build:prod": "bun build src/index.ts --outdir dist --target node --external @azure/functions-core",
        "lint": "eslint --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "test:func": "bun build:prod && func start -p 7070"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@azure/functions": "4.7.2",
        "@repo/db": "workspace:*",
        "@repo/logger": "workspace:*"
    }
}
