{
    "name": "@repo/api",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "type": "module",
    "private": true,
    "scripts": {
        "build:prod": "bun build src/index.ts --outdir dist --target bun --packages external",
        "build:dev": "bun run build:prod && NODE_OPTIONS=\"--max_old_space_size=8192\" tsc",
        "dev": "bun run --hot src/index.ts",
        "start": "bun run dist/index.js",
        "lint": "eslint --max-warnings 0",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@hono/zod-validator": "^0.5.0",
        "@repo/ai": "workspace:*",
        "@repo/auth": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/logger": "workspace:*",
        "@repo/s3": "workspace:*",
        "@repo/x": "workspace:*",
        "axios": "^1.9.0",
        "hono": "^4.7.11",
        "luxon": "^3.6.1"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@repo/typescript-config": "workspace:*",
        "@repo/eslint-config": "workspace:*"
    }
}
