{
    "name": "@repo/api",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "private": true,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build:dev": "bun build src/index.ts --outdir dist --target bun --packages external && NODE_OPTIONS=\"--max_old_space_size=8192\" tsc",
        "build:prod": "bun build src/index.ts --outdir dist --target bun",
        "dev": "bun run --hot src/index.ts",
        "start": "bun run index.ts",
        "lint": "eslint --max-warnings 0",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@repo/s3": "workspace:*",
        "@hono/zod-validator": "^0.5.0",
        "@repo/ai": "workspace:*",
        "@repo/auth": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/logger": "workspace:*",
        "@repo/x": "workspace:*",
        "axios": "^1.9.0",
        "hono": "^4.7.11",
        "luxon": "^3.6.1"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@repo/typescript-config": "workspace:*",
        "@repo/eslint-config": "workspace:*"
    }
}
