{
    "name": "@repo/cron-handler",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "type": "module",
    "private": true,
    "scripts": {
        "build:dev": "bun build:prod && NODE_OPTIONS=\"--max_old_space_size=8192\" tsc",
        "build:prod": "bun build src/index.ts --outdir dist --target bun --format esm --packages external",
        "start": "bun run dist/index.js",
        "dev": "bun run src/index.ts",
        "lint": "eslint --max-warnings 0",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/bun": "latest",
        "@repo/cron-sender": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@azure/storage-queue": "^12.27.0",
        "@repo/ai": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/logger": "workspace:*",
        "@repo/mail-templates": "workspace:*",
        "@repo/mailer": "workspace:*",
        "dotenv": "^17.2.1"
    }
}
