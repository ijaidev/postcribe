{
    "name": "@repo/cron-handler",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "type": "module",
    "private": true,
    "scripts": {
        "build:dev": "bun build:prod && NODE_OPTIONS=\"--max_old_space_size=8192\" tsc",
        "build:prod": "bun run build.js",
        "start": "bun build:prod && func start -p 7074",
        "lint": "eslint --max-warnings 0",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/bun": "latest",
        "@repo/cron-sender": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@azure/functions": "4.7.2",
        "@repo/ai": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/logger": "workspace:*",
        "@repo/mail-templates": "workspace:*",
        "@repo/mailer": "workspace:*",
        "dotenv": "^17.2.0"
    }
}
