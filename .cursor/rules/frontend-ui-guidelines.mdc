## API Integration & Data Fetching

### Hono Client Setup (Type-Safe API Calls)
**Always use the configured Hono client for API calls with full TypeScript support:**

```tsx
import client from '@/lib/hono-client'
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { InferResponseType } from 'hono'

// ✅ CORRECT: Type-safe API calls with React Query and proper typing
type SocialAccount = NonNullable<
  InferResponseType<typeof client.social.accounts.$get>["data"]
>[number]

function useSocialAccounts() {
  return useQuery({
    queryKey: ['social-accounts'],
    queryFn: async () => {
      const response = await client.social.accounts.$get()
      if (!response.ok) {
        throw new Error('Failed to fetch social accounts')
      }
      return response.json()
    },
    staleTime: 5 * 60 * 1000, // 5 minutes
    gcTime: 10 * 60 * 1000,   // 10 minutes
  })
}
```

### Streaming Response Patterns (NEW)
**For AI-generated content with real-time updates:**

```tsx
import { parse, Allow } from 'partial-json'
import { type PostGenStreamResponse } from '@repo/ai'

interface StreamData extends PostGenStreamResponse {
  platform: "X" | "LINKEDIN"
  draftId: string
}

interface DraftState {
  posts: { post: string; version: number }[]
  images: { url: string; version: number }[]
  currentPostVersion: number
  currentImageVersion: number
}

// Complete streaming mutation with advanced state management
const createPostMutation = useMutation({
  mutationFn: async (data: DraftCreate) => {
    const response = await client.post.draft.$post({ json: data })
    if (!response.ok) throw new Error("Failed to create post")
    return response
  },
  onMutate: () => {
    // Reset streaming state for regeneration
    setCurrentEvent({ x: null, linkedin: null })
    setOptions({ x: [], linkedin: [] })
    hasStarted.current = { x: false, linkedin: false }
  },
  onSuccess: async (response) => {
    const reader = response.body?.getReader()
    if (!reader) throw new Error("No response stream available")

    const decoder = new TextDecoder()
    let receivedDraftId = ""
    const buffer = { x: "", linkedin: "" }

    try {
      while (true) {
        const { done, value } = await reader.read()
        if (done) break

        const chunk = decoder.decode(value, { stream: true })
        const lines = chunk.split('\n').filter(line => line.trim())

        for (const line of lines) {
          try {
            const data: StreamData = JSON.parse(line)
            console.log(`🌊 STREAM - Raw data:`, data)

            // Handle draft ID for URL management
            if (data.draftId && !receivedDraftId) {
              receivedDraftId = data.draftId
              if (!draftId) {
                const newUrl = `/draft?draftId=${data.draftId}`
                window.history.replaceState(null, '', newUrl)
                setDraftId(data.draftId)
              }
            }

            const platformKey = data.platform.toLowerCase() as 'x' | 'linkedin'
            
            // Update current event for UI indicators
            setCurrentEvent(prev => ({
              ...prev,
              [platformKey]: data.event
            }))

            // Handle different event types
            if (data.event === "search") {
              // Show search indicator
              console.log(`🔍 SEARCH - ${data.platform}: ${data.content}`)
            } else if (data.event === "extract") {
              // Show extraction indicator
              console.log(`📝 EXTRACT - ${data.platform}: ${data.content}`)
            } else if (data.event === "response") {
              // Accumulate response content
              buffer[platformKey] += data.content
              
              // Parse partial JSON for real-time updates
              const parsed = parse(buffer[platformKey], Allow.ALL) as any
              const newContent = parsed?.post || ""
              const newOptions = parsed?.options || []
              
              // Determine if this is a new post or update
              const isFirstTime = !hasStarted.current[platformKey]
              if (isFirstTime) {
                hasStarted.current[platformKey] = true
              }
              
              // Update draft state with streaming content
              setDraftState(prev => ({
                ...prev,
                [platformKey]: {
                  ...prev[platformKey],
                  posts: isFirstTime 
                    ? [...prev[platformKey].posts, { 
                        post: newContent, 
                        version: prev[platformKey].posts.length 
                      }]
                    : prev[platformKey].posts.map((p, i) => 
                        i === prev[platformKey].posts.length - 1 
                          ? { ...p, post: newContent } 
                          : p
                      ),
                  currentPostVersion: isFirstTime 
                    ? prev[platformKey].posts.length 
                    : prev[platformKey].currentPostVersion
                }
              }))
              
              // Update options if available
              if (newOptions.length > 0) {
                setOptions(prev => ({
                  ...prev,
                  [platformKey]: newOptions
                }))
              }
            }
          } catch (err) {
            // Ignore JSON parse errors for partial streaming chunks
            console.log('JSON parse error (expected during streaming):', err)
          }
        }
      }
    } finally {
      // Clear streaming indicators
      setCurrentEvent({ x: null, linkedin: null })
      toast.success("Post generated successfully!")
    }
  }
})

// Real-time UI indicators during streaming
function StreamingIndicator({ platform, event }: { platform: string, event: string | null }) {
  if (!event) return null

  const icons = {
    search: <Search className="h-4 w-4 animate-spin" />,
    extract: <FileText className="h-4 w-4 animate-pulse" />,
    response: <Edit className="h-4 w-4 animate-bounce" />
  }

  const labels = {
    search: "Searching web...",
    extract: "Extracting content...", 
    response: "Generating post..."
  }

  return (
    <div className="flex items-center gap-2 text-sm text-muted-foreground">
      {icons[event as keyof typeof icons]}
      <span>{labels[event as keyof typeof labels]}</span>
      <Badge variant="outline" className="text-xs">
        {platform}
      </Badge>
    </div>
  )
}
```

### File Upload Patterns (NEW)
**For drag-and-drop file uploads with progress tracking:**

```tsx
interface UploadedImage {
  id: string
  file: File
  preview: string
  uploaded: boolean
  uploading: boolean
  imageUrl?: string
}

// Complete file upload system with validation and progress
const uploadImageMutation = useMutation({
  mutationFn: async (image: UploadedImage) => {
    const response = await client.post.draft.image.upload.$post({
      form: { image: image.file }
    })
    const result = await response.json()
    if (!response.ok) {
      throw new Error(result.message || 'Failed to upload image')
    }
    if (!result.data?.imageUrl) {
      throw new Error(result.message || 'No image URL returned')
    }
    return result.data.imageUrl
  },
  onSuccess: (imageUrl, image) => {
    // Update image with uploaded URL
    setImages(prev => prev.map(img =>
      img.id === image.id
        ? { ...img, uploaded: true, uploading: false, imageUrl }
        : img
    ))
    toast.success(`${image.file.name} uploaded successfully`)
  },
  onError: (error, image) => {
    console.error('Upload error:', error)
    toast.error(error instanceof Error ? error.message : 'Failed to upload image')
    // Remove failed image
    setImages(prev => prev.filter(img => img.id !== image.id))
  }
})

// File handling with comprehensive validation
const handleFiles = async (files: FileList | File[]) => {
  const newFiles = Array.from(files)

  // Check if adding these files would exceed the limit
  if (images.length + newFiles.length > 5) {
    toast.error(`You can only upload up to 5 images. Currently have ${images.length} images.`)
    return
  }

  const validFiles = newFiles.filter(file => {
    const isImage = file.type === 'image/jpeg' || file.type === 'image/png' || file.type === 'image/webp'
    const isValidSize = file.size <= 5 * 1024 * 1024 // 5MB limit

    if (!isImage) {
      toast.error(`${file.name} is not an image file`)
      return false
    }
    if (!isValidSize) {
      toast.error(`${file.name} is too large (max 5MB)`)
      return false
    }
    return true
  })

  if (validFiles.length > 0) {
    const newImages = validFiles.map(createImagePreview)
    
    // Add images with uploading state
    setImages(prev => [...prev, ...newImages.map(img => ({ ...img, uploading: true }))])
    
    // Upload each image using mutation
    newImages.forEach((image) => {
      uploadImageMutation.mutate(image)
    })
    
    toast.success(`Starting upload of ${validFiles.length} image(s)`)
  }
}

// Complete drag and drop handlers
const handleDragEnter = (e: React.DragEvent) => {
  e.preventDefault()
  e.stopPropagation()
  setIsDragging(true)
}

const handleDragLeave = (e: React.DragEvent) => {
  e.preventDefault()
  e.stopPropagation()
  setIsDragging(false)
}

const handleDragOver = (e: React.DragEvent) => {
  e.preventDefault()
  e.stopPropagation()
}

const handleDrop = (e: React.DragEvent) => {
  e.preventDefault()
  e.stopPropagation()
  setIsDragging(false)
  
  if (e.dataTransfer.files) {
    handleFiles(e.dataTransfer.files)
  }
}

// Paste functionality for images from clipboard
const handlePaste = (e: React.ClipboardEvent) => {
  const items = Array.from(e.clipboardData.items)
  const imageFiles = items
    .filter(item => item.type.startsWith('image/'))
    .map(item => item.getAsFile())
    .filter((file): file is File => file !== null)

  if (imageFiles.length > 0) {
    handleFiles(imageFiles)
  }
}

// Image preview creation
const createImagePreview = (file: File): UploadedImage => {
  return {
    id: Math.random().toString(36).substring(7),
    file,
    preview: URL.createObjectURL(file),
    uploaded: false,
    uploading: false,
  }
}

// Remove image with cleanup
const removeImage = (id: string) => {
  setImages(prev => {
    const imageToRemove = prev.find(img => img.id === id)
    if (imageToRemove) {
      URL.revokeObjectURL(imageToRemove.preview)
    }
    return prev.filter(img => img.id !== id)
  })
}

// UI component with drag states
<Card
  className={`relative rounded-2xl border shadow-lg transition-all duration-300 p-6 ${
    isDragging
      ? "border-primary shadow-2xl scale-[1.02] bg-primary/5 ring-2 ring-primary/20"
      : "border-border hover:shadow-xl"
  }`}
  onDragEnter={handleDragEnter}
  onDragLeave={handleDragLeave}  
  onDragOver={handleDragOver}
  onDrop={handleDrop}
>
  {/* Image previews with upload progress */}
  {images.length > 0 && (
    <div className="flex flex-wrap gap-2 mb-4">
      {images.map((image) => (
        <div key={image.id} className="relative group">
          <Image
            src={image.preview}
            alt="Upload preview"
            width={64}
            height={64}
            className={`w-16 h-16 object-cover rounded-lg border-2 shadow-sm transition-opacity ${
              image.uploading && 'border-primary opacity-70'
            }`}
          />
          
          {/* Upload loading overlay */}
          {image.uploading && (
            <div className="absolute inset-0 bg-black/50 rounded-lg flex items-center justify-center">
              <Loader2 className="h-4 w-4 animate-spin text-white" />
            </div>
          )}
          
          {/* Remove button */}
          <button
            onClick={() => removeImage(image.id)}
            className="absolute -top-1 -right-1 p-0.5 bg-destructive text-destructive-foreground rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-destructive/90 text-xs"
          >
            <X className="h-3 w-3" />
          </button>
        </div>
      ))}
      <div className="text-xs text-muted-foreground flex items-center">
        {images.length}/5 images
        {images.some(img => img.uploading) && (
          <span className="ml-2 text-primary">Uploading...</span>
        )}
      </div>
    </div>
  )}

  {/* Enhanced Drag overlay */}
  {isDragging && (
    <div className="absolute inset-4 bg-gradient-to-br from-primary/10 to-primary/5 rounded-xl flex items-center justify-center border-2 border-dashed border-primary animate-pulse pointer-events-none">
      <div className="text-center space-y-3">
        <div className="relative">
          <ImagePlus className="h-12 w-12 text-primary mx-auto animate-bounce" />
          <div className="absolute inset-0 h-12 w-12 bg-primary/20 rounded-full animate-ping"></div>
        </div>
        <p className="text-lg font-semibold text-primary">Drop your images here</p>
        <p className="text-sm text-primary/70">Support JPG, PNG up to 5MB (max 5 images)</p>
      </div>
    </div>
  )}
</Card>
