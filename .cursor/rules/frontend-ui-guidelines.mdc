    <div className="border rounded-lg p-4">  {/* Don't recreate Card */}
      <h1 className="text-4xl font-bold">Title</h1>  {/* Don't recreate H1 */}
      <div className="flex gap-2">  {/* Don't recreate ResendVerificationEmail */}
