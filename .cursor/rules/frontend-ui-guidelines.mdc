## API Integration & Data Fetching

### Hono Client Setup (Type-Safe API Calls)
**Always use the configured Hono client for API calls with full TypeScript support:**

```tsx
import client from '@/lib/hono-client'
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { InferResponseType } from 'hono'

// ✅ CORRECT: Type-safe API calls with React Query and proper typing
type SocialAccount = NonNullable<
  InferResponseType<typeof client.social.accounts.$get>["data"]
>[number]

function useSocialAccounts() {
  return useQuery({
    queryKey: ['social-accounts'],
    queryFn: async () => {
      const response = await client.social.accounts.$get()
      if (!response.ok) {
        throw new Error('Failed to fetch social accounts')
      }
      return response.json()
    },
    staleTime: 5 * 60 * 1000, // 5 minutes
    gcTime: 10 * 60 * 1000,   // 10 minutes
  })
}

function useConnectXAccount() {
  const queryClient = useQueryClient()
  
  return useMutation({
    mutationFn: async (username: string) => {
      const response = await client.social.login.x.$post({
        json: { username }
      })
      if (!response.ok) {
        throw new Error('Failed to connect X account')
      }
      return response.json()
    },
    onSuccess: (result) => {
      // Update query cache optimistically
      queryClient.setQueryData(
        ['social-accounts'],
        (oldData: InferResponseType<typeof client.social.accounts.$get>) => {
          if (!oldData?.data) return oldData
          return {
            ...oldData,
            data: [...oldData.data, result.data!.account],
          }
        }
      )
      toast.success('X account connected successfully!')
    },
    onError: (error) => {
      toast.error(error.message || 'Failed to connect X account')
    }
  })
}

// Usage in component
function ConnectionsPage() {
  const { data: socialAccounts, isLoading, error } = useSocialAccounts()
  const connectXMutation = useConnectXAccount()

  if (isLoading) {
    return <ThreeDotLoader size="lg" />
  }

  if (error) {
    return (
      <Alert variant="destructive">
        <AlertDescription>Failed to load accounts</AlertDescription>
      </Alert>
    )
  }

  return (
    <div className="space-y-4">
      <Button 
        onClick={() => connectXMutation.mutate('username')}
        disabled={connectXMutation.isPending}
      >
        {connectXMutation.isPending ? <ThreeDotLoader size="sm" /> : 'Connect X'}
      </Button>
      
      {socialAccounts?.data?.map(account => (
        <Card key={account.id}>
          <CardContent>
            <H3>{account.name}</H3>
            <Badge variant={account.isConnected ? "default" : "destructive"}>
              {account.isConnected ? "Connected" : "Disconnected"}
            </Badge>
          </CardContent>
        </Card>
      ))}
    </div>
  )
}

// ❌ WRONG: Direct fetch calls without type safety or caching
async function fetchAccounts() {
  const response = await fetch('/api/accounts') // No type safety
  return response.json() // No caching, no error handling
}
```

### React Query Patterns
```tsx
import { useQuery, useMutation, useQueryClient, useInfiniteQuery } from '@tanstack/react-query'
import client from '@/lib/hono-client'

// Standard query pattern
function useResource(id: string) {
  return useQuery({
    queryKey: ['resource', id],
    queryFn: async () => {
      const response = await client.v1.resource[':id'].$get({ param: { id } })
      if (!response.ok) throw new Error('Failed to fetch')
      return response.json()
    },
    enabled: !!id, // Only run if id exists
  })
}

// Mutation with optimistic updates
function useUpdateResource() {
  const queryClient = useQueryClient()
  
  return useMutation({
    mutationFn: async ({ id, data }: { id: string; data: any }) => {
      const response = await client.v1.resource[':id'].$put({ 
        param: { id }, 
        json: data 
      })
      if (!response.ok) throw new Error('Update failed')
      return response.json()
    },
    onMutate: async ({ id, data }) => {
      // Cancel outgoing refetches
      await queryClient.cancelQueries({ queryKey: ['resource', id] })
      
      // Snapshot previous value
      const previousData = queryClient.getQueryData(['resource', id])
      
      // Optimistically update
      queryClient.setQueryData(['resource', id], data)
      
      return { previousData }
    },
    onError: (err, { id }, context) => {
      // Rollback on error
      if (context?.previousData) {
        queryClient.setQueryData(['resource', id], context.previousData)
      }
    },
    onSettled: (data, error, { id }) => {
      // Always refetch after mutation
      queryClient.invalidateQueries({ queryKey: ['resource', id] })
    }
  })
}

// Infinite queries for pagination
function useInfinitePosts() {
  return useInfiniteQuery({
    queryKey: ['posts', 'infinite'],
    queryFn: async ({ pageParam = 0 }) => {
      const response = await client.v1.posts.$get({ 
        query: { 
          page: pageParam.toString(),
          limit: '10'
        }
      })
      if (!response.ok) throw new Error('Failed to fetch')
      return response.json()
    },
    initialPageParam: 0,
    getNextPageParam: (lastPage, allPages) => {
      return lastPage.hasMore ? allPages.length : undefined
    }
  })
}
```

### Authentication with Better-Auth
**Use the centralized auth system with proper error handling:**

```tsx
import { authClient } from '@/lib/auth-client'
import { useUser } from '@/components/providers/user-provider'

// ✅ CORRECT: Use UserProvider for auth state
function useAuthActions() {
  const { refreshUser } = useUser()
  const queryClient = useQueryClient()
  
  const signIn = useMutation({
    mutationFn: async ({ email, password }: { email: string; password: string }) => {
      const { data, error } = await authClient.signIn.email({ email, password })
      if (error) throw new Error(error.message)
      return data
    },
    onSuccess: async () => {
      await refreshUser() // Refresh user context
      queryClient.clear() // Clear all queries on login
      toast.success('Signed in successfully!')
    }
  })

  const signOut = useMutation({
    mutationFn: async () => {
      await authClient.signOut()
    },
    onSuccess: async () => {
      await refreshUser() // Clear user context
      queryClient.clear() // Clear all queries on logout
      toast.success('Signed out successfully!')
    }
  })

  return { signIn, signOut }
}

// ❌ WRONG: Direct authClient usage without context integration
const handleSignIn = async () => {
  await authClient.signIn.email({ email, password }) // Missing error handling and context refresh
}
```

## User Management & Authentication

### UserProvider Context (ALWAYS USE THIS)
**The app uses a centralized user management system. ALWAYS use the useUser hook instead of direct auth calls.**

```tsx
import { useUser } from '@/components/providers/user-provider'

function MyComponent() {
  const { 
    user,           // User | null - current user data
    isLoading,      // boolean - loading state for user data
    isAuthenticated, // boolean - whether user is authenticated
    emailVerified,  // boolean - whether user's email is verified
    error,          // string | null - error message if any
    refreshUser     // () => Promise<void> - refresh user data
  } = useUser()

  // Loading state - ALWAYS handle this first
  if (isLoading) {
    return (
      <div className="flex items-center justify-center py-8">
        <ThreeDotLoader size="lg" />
        <span className="ml-2 text-sm text-muted-foreground">Loading...</span>
      </div>
    )
  }

  // Error state
  if (error) {
    return (
      <Alert variant="destructive">
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )
  }

  // Not authenticated
  if (!isAuthenticated || !user) {
    return <div>Please sign in to continue</div>
  }

  // Email not verified (if required)
  if (!emailVerified) {
    return (
      <div className="space-y-4">
        <Alert>
          <AlertDescription>Please verify your email address</AlertDescription>
        </Alert>
        <ResendVerificationEmail email={user.email} />
      </div>
    )
  }

  // Authenticated user with verified email
  return (
    <div>
      <H1>Welcome, {user.name || 'User'}!</H1>
      <p>Email: {user.email}</p>
      <p>Timezone: {user.timeZone || 'Not set'}</p>
      <Button onClick={refreshUser}>Refresh User Data</Button>
    </div>
  )
}
```

### User Data Interface
```tsx
interface User {
  id: string
  email: string
  name?: string | null
  timeZone?: string | null
  emailVerified: boolean
  image?: string | null
}

interface UserContextType {
  user: User | null
  isLoading: boolean
  isAuthenticated: boolean
  emailVerified: boolean
  error: string | null
  refreshUser: () => Promise<void>
}
