## Implementation Patterns

### Authentication Flow
1. **Signup**: Email/password OR Google OAuth → Step 2 (name + timezone)
2. **Email Verification**: Automatic email + resend component
3. **Login**: Email/password OR Google OAuth → Dashboard
4. **Route Protection**: Automatic redirect to signin if not authenticated

### Form Patterns
```tsx
// Standard form with Zod validation
const schema = z.object({
  name: z.string().min(1, "Required"),
  email: z.string().email("Invalid email"),
})

const form = useForm<z.infer<typeof schema>>({
  resolver: zodResolver(schema),
  defaultValues: { name: "", email: "" }
})

const onSubmit = async (values: z.infer<typeof schema>) => {
  setIsLoading(true)
  try {
    // API call
    toast.success("Success!")
  } catch (error) {
    toast.error("Error occurred")
  } finally {
    setIsLoading(false)
  }
}
```

### Loading State Patterns
```tsx
// Button loading state
<Button disabled={isLoading}>
  {isLoading ? <ThreeDotLoader size="sm" /> : 'Submit'}
</Button>

// Page loading state
if (isPending) {
  return (
    <div className="flex min-h-svh items-center justify-center">
      <div className="flex flex-col items-center gap-4">
        <ThreeDotLoader size="lg" />
        <p className="text-sm text-muted-foreground">Loading...</p>
      </div>
    </div>
  )
}
```

### Error Handling Patterns
```tsx
// Better-Auth error mapping
const getErrorMessage = (errorCode: string, defaultMessage: string) => {
  const errorMessages = {
    'USER_ALREADY_EXISTS': 'Account already exists',
    'INVALID_CREDENTIALS': 'Invalid email or password',
    'EMAIL_NOT_VERIFIED': 'Please verify your email',
  }
  return errorMessages[errorCode] || defaultMessage
}

// Toast error display
try {
  const { data, error } = await authClient.signIn.email(values)
  if (error) {
    toast.error(getErrorMessage(error.code, error.message))
    return
  }
} catch (err: any) {
  toast.error("Something went wrong. Please try again.")
}
```

